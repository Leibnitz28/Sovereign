# ============================================================
# SOVEREIGN — Environment Configuration
# ============================================================
# Copy to .env and fill in values. NEVER commit .env with secrets.

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://sovereign:sovereign@localhost:5432/sovereign
REDIS_URL=redis://localhost:6379

# ─── KeeperHub ──────────────────────────────────────────────
KEEPERHUB_API_KEY=
KEEPERHUB_MCP_URL=
KEEPERHUB_API_URL=

# ─── Daydreams / Lucid ─────────────────────────────────────
DAYDREAMS_API_URL=
DAYDREAMS_API_KEY=

# ─── Blockchain ─────────────────────────────────────────────
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
ESCROW_CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# ─── Application ────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
API_PORT=3001
WEB_PORT=3000

# ─── Feature Flags ──────────────────────────────────────────
MOCK_EXTERNAL_SERVICES=true
ENABLE_REAL_SETTLEMENT=false
ENABLE_DAYDREAMS_LIVE=false
ENABLE_REPUTATION=true
ENABLE_RISK_ENGINE=true
